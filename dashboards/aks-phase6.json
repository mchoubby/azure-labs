{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Azure Managed Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "AKS - Phase 6",
  "uid": "aks-phase6",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(kube_deployment_status_replicas_available, cluster)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU demo-app par pod (cores)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\",namespace=\"demo-app\",container=\"demo-app\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memoire demo-app par pod",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{cluster=\"$cluster\",namespace=\"demo-app\",container=\"demo-app\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Replicas disponibles vs souhaites",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{cluster=\"$cluster\",namespace=\"demo-app\",deployment=\"demo-app\"}",
          "legendFormat": "disponibles"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_spec_replicas{cluster=\"$cluster\",namespace=\"demo-app\",deployment=\"demo-app\"}",
          "legendFormat": "souhaites"
        }
      ]
    },
    {
      "id": 4,
      "title": "HPA : replicas courants vs demandes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{cluster=\"$cluster\",namespace=\"demo-app\",horizontalpodautoscaler=\"demo-app\"}",
          "legendFormat": "courants"
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{cluster=\"$cluster\",namespace=\"demo-app\",horizontalpodautoscaler=\"demo-app\"}",
          "legendFormat": "demandes"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redemarrages demo-app",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total{cluster=\"$cluster\",namespace=\"demo-app\",container=\"demo-app\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
