project_name = "aksdemo"
environment  = "dev"
location     = "francecentral"

admin_object_ids = ["<ton-object-id-azure-ad>"]

github_repository = "<nom-du-repo>"

# Si GitHub émet le subject OIDC au format immutable (repo:owner@<id>/repo@<id>:...,
# visible dans le log "subject claim" de azure/login), renseigner les IDs :
# github_repository_ids = { owner_id = <owner-id>, repository_id = <repo-id> }
